{
  "name": "induction-motor-testing",
  "productName": "Induction Motor Testing",
  "version": "2.0.0",
  "description": "Offline desktop application for the UET Motor Testing Lab: records three-phase induction motor tests, computes performance and prints the test report.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "pk.edu.uet.motorlab",
    "productName": "Induction Motor Testing",
    "files": ["main.js", "preload.js", "src/**", "renderer/**", "assets/**"],
    "win": { "target": "nsis", "icon": "assets/icons/icon-1024.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": "AppImage", "icon": "assets/icons/icon-1024.png" }
  },
  "license": "CC0-1.0",
  "devDependencies": {
    "chart.js": "^4.5.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "mdb-reader": "^3.2.0"
  }
}
